<!-- 首页：拍照/选图 + 尺寸选择 -->
<view class="container safe-bottom">

  <!-- 操作区 -->
  <view class="action-area">
    <view class="card action-card" bindtap="onTakePhoto">
      <text class="action-icon">📷</text>
      <text class="action-title">拍照</text>
      <text class="action-desc">使用相机拍摄</text>
    </view>
    <view class="card action-card" bindtap="onChooseFromAlbum">
      <text class="action-icon">🖼️</text>
      <text class="action-title">相册选取</text>
      <text class="action-desc">从相册选择已有照片</text>
    </view>
  </view>

  <!-- 提示 -->
  <view class="section-hint" wx:if="{{!selectedId}}">
    <text>👇 请选择证件照尺寸，然后拍照或选图</text>
  </view>
  <view class="section-hint ready" wx:else>
    <text>✅ 已选尺寸，点击上方拍照或选图</text>
  </view>

  <!-- 尺寸模板列表 -->
  <view wx:for="{{templates}}" wx:key="group" wx:for-item="group">
    <view class="section-title">{{group.group}}</view>
    <view class="size-grid">
      <view
        class="size-item {{selectedId === item.id ? 'selected' : ''}}"
        wx:for="{{group.items}}"
        wx:key="id"
        wx:for-item="item"
        data-id="{{item.id}}"
        bindtap="onTemplateTap"
      >
        <view class="size-preview" style="aspect-ratio:{{item.mmW}}/{{item.mmH}};background:{{item.bg}}">
          <text class="size-label">{{item.name}}</text>
        </view>
        <text class="size-info">{{item.mmW}}×{{item.mmH}}mm</text>
        <text class="size-info-sub">{{item.pxW}}×{{item.pxH}}px</text>
      </view>
    </view>
  </view>

  <!-- 底部安全间距 -->
  <view style="height:48rpx"></view>
</view>

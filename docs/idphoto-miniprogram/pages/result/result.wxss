/* 结果页 */
.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* 预览区 */
.preview-area {
  text-align: center;
  margin-bottom: 32rpx;
}

.preview-label {
  font-size: 24rpx;
  color: var(--text2);
  margin-bottom: 12rpx;
  display: block;
}

.preview-card {
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
}

.preview-img {
  max-width: 100%;
  max-height: 600rpx;
  border-radius: 8rpx;
}

.preview-empty {
  color: var(--text2);
  padding: 120rpx 0;
}

/* 底色选择 */
.section {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  display: block;
}

.color-grid {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius);
  background: var(--card);
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.color-item.active {
  border-color: var(--blue);
  background: var(--blue-light);
}

.color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #E0E0E0;
}

.color-name {
  font-size: 22rpx;
  color: var(--text);
}

/* AI抠图按钮 */
.btn-ai {
  width: 100%;
  padding: 28rpx;
  border-radius: var(--radius);
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.btn-ai::after { border: none; }

.btn-ai[disabled] {
  background: #CCC;
  color: #999;
}

.ai-hint {
  font-size: 22rpx;
  color: var(--text2);
  text-align: center;
  display: block;
  margin-top: 8rpx;
}

/* 底部操作 */
.bottom-actions {
  margin-top: 40rpx;
  text-align: center;
}

.btn-save {
  width: 100%;
  padding: 32rpx;
  border-radius: var(--radius);
  background: var(--blue);
  color: white;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
  margin-bottom: 24rpx;
}

.btn-save::after { border: none; }

.sub-actions {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.link-btn {
  font-size: 28rpx;
  color: var(--blue);
  padding: 8rpx;
}

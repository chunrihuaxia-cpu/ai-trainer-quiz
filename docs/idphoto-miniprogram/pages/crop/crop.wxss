/* 裁剪页 */
.crop-container {
  width: 100vw;
  height: 100vh;
  background: #1A1A1A;
  display: flex;
  flex-direction: column;
}

/* 加载 */
.loading {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #999;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #333;
  border-top-color: var(--blue);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* Canvas */
.canvas-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.crop-canvas {
  width: calc(100vw - 48rpx);
  height: calc(100vw * 1.35);
  margin: auto;
}

.crop-hint {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.6);
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
}

.crop-hint text {
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
}

/* 底部工具栏 */
.bottom-bar {
  background: #222;
  padding: 24rpx 32rpx;
}

.info-text {
  text-align: center;
  margin-bottom: 16rpx;
  color: white;
  font-size: 28rpx;
  font-weight: 600;
}

.info-detail {
  display: block;
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
  margin-top: 4rpx;
}

.bar-actions {
  display: flex;
  gap: 20rpx;
}

.btn-back {
  flex: 0 0 160rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #333;
  color: white;
  border-radius: var(--radius);
  font-size: 28rpx;
  border: none;
}

.btn-back::after { border: none; }

.btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--blue);
  color: white;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.btn-confirm::after { border: none; }

/* 刷题页样式 */

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 24rpx;
}

.spinner {
  width: 72rpx;
  height: 72rpx;
  border: 6rpx solid var(--sep);
  border-top-color: var(--blue);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 28rpx;
  color: var(--text2);
}

/* 顶部工具栏 */
.toolbar {
  background: var(--card);
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--sep);
  position: sticky;
  top: 0;
  z-index: 100;
}

.tool-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tool-progress {
  font-size: 26rpx;
  color: var(--text2);
  white-space: nowrap;
}

.tool-progress-bar {
  flex: 1;
  height: 10rpx;
  background: var(--sep);
  border-radius: 5rpx;
  overflow: hidden;
}

.tool-progress-fill {
  height: 100%;
  background: var(--blue);
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

.tool-rate {
  font-size: 30rpx;
  font-weight: 700;
}

.tool-wrong {
  font-size: 24rpx;
  margin-left: -8rpx;
}

.tool-actions {
  margin-top: 14rpx;
  gap: 12rpx;
}

.tool-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  border: 2rpx solid var(--sep);
  background: var(--card);
  color: var(--text);
}

/* 题目卡片 */
.q-card {
  background: var(--card);
  border-radius: var(--radius);
  margin: 20rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.q-badge {
  display: inline-block;
  padding: 6rpx 24rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.badge-judge  { background: #E8F5FF; color: #007AFF; }
.badge-single { background: #FFF3E0; color: #FF9500; }
.badge-multi  { background: #F3E8FF; color: #AF52DE; }

.q-number {
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 16rpx;
  display: block;
}

.q-text {
  font-size: 34rpx;
  line-height: 1.7;
  font-weight: 500;
  margin-bottom: 32rpx;
  display: block;
}

/* 判断题按钮 */
.judge-btns {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.judge-btn {
  flex: 1;
  padding: 36rpx;
  border-radius: var(--radius);
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: white;
  transition: all 0.15s;
}

.judge-btn:active { transform: scale(0.96); }

.true-btn  { background: var(--green); }
.false-btn { background: var(--red); }

.correct-ans {
  outline: 6rpx solid #007AFF;
  outline-offset: 4rpx;
}

.wrong-ans {
  opacity: 0.4;
  transform: scale(0.95);
}

/* 选项 */
.options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.opt-btn {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--radius);
  border: 3rpx solid var(--sep);
  background: var(--card);
  transition: all 0.15s;
}

.opt-hover { transform: scale(0.98); background: #F2F2F7; }

.opt-label {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 28rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.opt-label-active {
  background: var(--blue) !important;
  color: white !important;
}

.opt-text { flex: 1; font-size: 30rpx; }

/* 选项选中态 */
.opt-btn.selected {
  border-color: var(--blue);
  background: #E8F5FF;
}

/* 选项答题结果态 */
.opt-btn.correct, .opt-btn.reveal {
  border-color: var(--green);
  background: #E8F8ED;
}
.opt-btn.correct .opt-label, .opt-btn.reveal .opt-label {
  background: var(--green);
  color: white;
}

.opt-btn.wrong {
  border-color: var(--red);
  background: #FFECEB;
}
.opt-btn.wrong .opt-label {
  background: var(--red);
  color: white;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 20rpx;
  width: 100%;
  padding: 32rpx;
  border-radius: var(--radius);
  background: var(--blue);
  color: white;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
}

.submit-btn::after { border: none; }

.submit-btn[disabled] {
  background: #CCC;
  color: #999;
}

/* 解析区 */
.explanation {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: #FFF9E8;
  border: 2rpx solid #FFE8A0;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.exp-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--orange);
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 8rpx;
}

.exp-answer {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--green);
  display: block;
  margin-bottom: 12rpx;
}

.exp-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text);
  display: block;
}

.next-btn {
  margin-top: 24rpx;
  width: 100%;
  padding: 28rpx;
  border-radius: 12rpx;
  background: var(--blue);
  color: white;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
}

.next-btn::after { border: none; }

/* 完成页 */
.complete-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  text-align: center;
}

.complete-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.complete-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}

.complete-stats {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 30rpx;
  margin-bottom: 16rpx;
}

.stat-green { color: var(--green); font-weight: 700; }
.stat-red  { color: var(--red); font-weight: 700; }

.stat-rate { margin-top: 8rpx; }

.rate-big {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--green);
}

.complete-wrongbook {
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 48rpx;
}

.complete-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 500rpx;
}

.act-btn {
  width: 100%;
  padding: 28rpx;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.act-btn::after { border: none; }

.act-btn.primary   { background: var(--blue); color: white; }
.act-btn.warn      { background: var(--orange); color: white; }
.act-btn.danger    { background: var(--red); color: white; }
.act-btn.secondary { background: var(--card); color: var(--text); border: 2rpx solid var(--sep); }
